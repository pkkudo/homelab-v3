apiVersion: v1
kind: Pod
metadata:
  name: haproxy
  namespace: kube-system
spec:
  containers:
  - image: {{ haproxy_image }}:{{ haproxy_image_tag }}
    name: haproxy
    livenessProbe:
      failureThreshold: 8
      httpGet:
        host: localhost
        path: /healthz
        port: {{ kube_endpoint_port }}
        scheme: HTTPS
    volumeMounts:
    - mountPath: /usr/local/etc/haproxy/haproxy.cfg
      name: haproxyconf
      readOnly: true
  hostNetwork: true
  volumes:
  - hostPath:
      path: /home/{{ ansible_user }}/static_pod_conf.d/haproxy.cfg
      type: FileOrCreate
    name: haproxyconf
status: {}
